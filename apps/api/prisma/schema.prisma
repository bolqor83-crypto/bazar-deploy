// Схема данных Bazar (Промт 7: минимальный фундамент).
//
// Провайдер конфигурируется через DATABASE_URL. Текущая демо-сборка
// работает на SQLite (см. ADR 0008: Docker/PostgreSQL и ключи Neon
// в песочнице недоступны, SQLite — последний fallback для demo).
// Переключение на PostgreSQL — замена DATABASE_URL + провайдера;
// перечисления здесь эмулируются строками с проверкой в DTO.
//
// За пределами Промта 7: Order, Debt, Delivery (Промт 9+).
// Промт 8 добавил каталог: Category → Product → ProductOffer.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Пользователь. Пароль хранится как хеш Argon2id — никогда не
/// покидает сервер (в ответах API его нет).
model User {
  id           String       @id @default(cuid())
  phone        String       @unique
  name         String
  passwordHash String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  memberships  Membership[]
  sessions     Session[]
}

/// Сессия refresh-токена. В БД лежит только SHA-256-хеш токена.
/// family связывает цепочку обновлений одного входа: при попытке
/// повторно использовать отозванный токен отзывается вся семья.
model Session {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshHash String    @unique
  family      String
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?
  userAgent   String?
  ip          String?

  @@index([userId])
  @@index([family])
}

/// Организация. type: WHOLESALE | RETAIL | LOGISTICS (строка вместо
/// enum — ограничение SQLite, значения проверяются в DTO).
model Organization {
  id          String             @id @default(cuid())
  name        String
  type        String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  memberships Membership[]
  locations   BusinessLocation[]
  offers      ProductOffer[]
}

/// Категория каталога (Промт 8). slug — адрес фильтра, icon — имя
/// иконки из набора Lucide (клиент маппит в компонент), sortOrder —
/// порядок в ленте категорий.
model Category {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  icon      String
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

/// Товар каталога. images — JSON-массив строк-URL (SQLite не имеет
/// нативных массивов); до загрузки фото клиент показывает плашку-
/// заглушку. Цены живут в ProductOffer: один товар — много продавцов.
model Product {
  id          String          @id @default(cuid())
  categoryId  String
  name        String
  unit        String
  description String          @default("")
  images      String          @default("[]")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  category    Category        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  offers      ProductOffer[]

  @@index([categoryId])
}

/// Предложение организации на товар: цена в копейках (без дробей),
/// склад, минимальная партия, бейдж («hit» — хит) и скоропорт.
/// badge — строка или null; набор значений расширяется без миграций.
model ProductOffer {
  id             String       @id @default(cuid())
  productId      String
  organizationId String
  priceKopecks   Int
  stock          Int
  minQuantity    Int          @default(1)
  badge          String?
  isPerishable   Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([organizationId])
}

/// Членство пользователя в организации.
/// role: CUSTOMER | STORE_OWNER | WHOLESALE_SELLER | CARRIER (строка
/// вместо enum — ограничение SQLite, значения проверяются в DTO).
model Membership {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([userId, organizationId, role])
  @@index([userId])
}

/// Торговая точка розничной организации.
model BusinessLocation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  address        String
  city           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}
