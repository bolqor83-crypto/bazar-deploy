// Схема данных Bazar (Промт 7: минимальный фундамент).
//
// С Промта 9 провайдер — PostgreSQL (Neon, ADR 0010): pooled-URI —
// для runtime, direct-URI — для миграций. SQLite остаётся локальным
// fallback без сети (архив миграций — _sqlite-migrations-backup).
// Промт 8 добавил каталог: Category → Product → ProductOffer.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL_POOLED")
  directUrl = env("DATABASE_URL_DIRECT")
}

/// Пользователь. Пароль хранится как хеш Argon2id — никогда не
/// покидает сервер (в ответах API его нет).
model User {
  id           String       @id @default(cuid())
  phone        String       @unique
  name         String
  passwordHash String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  memberships  Membership[]
  sessions     Session[]
  carts        Cart[]
  orders       Order[]      @relation("OrderBuyer")
  orderEvents  OrderEvent[] @relation("OrderActor")
}

/// Сессия refresh-токена. В БД лежит только SHA-256-хеш токена.
/// family связывает цепочку обновлений одного входа: при попытке
/// повторно использовать отозванный токен отзывается вся семья.
model Session {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshHash String    @unique
  family      String
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?
  userAgent   String?
  ip          String?

  @@index([userId])
  @@index([family])
}

/// Организация. type: WHOLESALE | RETAIL | LOGISTICS (строка вместо
/// enum — ограничение SQLite, значения проверяются в DTO).
model Organization {
  id          String             @id @default(cuid())
  name        String
  type        String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  memberships Membership[]
  locations   BusinessLocation[]
  offers      ProductOffer[]
  ordersAsSeller Order[]          @relation("OrderSeller")
}

/// Категория каталога (Промт 8). slug — адрес фильтра, icon — имя
/// иконки из набора Lucide (клиент маппит в компонент), sortOrder —
/// порядок в ленте категорий.
model Category {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  icon      String
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

/// Товар каталога. images — JSON-массив строк-URL (SQLite не имеет
/// нативных массивов); до загрузки фото клиент показывает плашку-
/// заглушку. Цены живут в ProductOffer: один товар — много продавцов.
model Product {
  id          String          @id @default(cuid())
  categoryId  String
  name        String
  unit        String
  description String          @default("")
  images      String          @default("[]")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  category    Category        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  offers      ProductOffer[]

  @@index([categoryId])
}

/// Предложение организации на товар: цена в копейках (без дробей),
/// склад, минимальная партия, бейдж («hit» — хит) и скоропорт.
/// badge — строка или null; набор значений расширяется без миграций.
model ProductOffer {
  id             String        @id @default(cuid())
  productId      String
  organizationId String
  priceKopecks   Int
  stock          Int
  minQuantity    Int           @default(1)
  badge          String?
  isPerishable   Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  product        Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cartItems      CartItem[]
  orderItems     OrderItem[]

  @@index([productId])
  @@index([organizationId])
}

/// Корзина пользователя в контуре (Промт 9, Часть D).
/// organizationId — торговый контур: «"» (розница/customer) или id
/// организации оптового контура. Пустая строка вместо NULL — иначе
/// @@unique([userId, organizationId]) в PostgreSQL не ловит дубли
/// (NULL ≠ NULL).
model Cart {
  id             String     @id @default(cuid())
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String     @default("")
  items          CartItem[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([userId, organizationId])
}

/// Позиция корзины: предложение продавца + количество.
/// @@unique([cartId, offerId]) — один оффер одна строка (количество
/// меняется PATCH'ем, а не новой строкой).
model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  offerId   String
  offer     ProductOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, offerId])
}

/// Заказ (Промт 9, Часть E): создаётся из корзины, группируется
/// по продавцу — позиции разных организаций раскладываются в
/// отдельные заказы. Номер BZ-YYYY-NNNNNN генерируется в транзакции.
model Order {
  id             String       @id @default(cuid())
  number         String       @unique
  buyerId        String
  buyer          User         @relation("OrderBuyer", fields: [buyerId], references: [id])
  sellerId       String
  seller         Organization @relation("OrderSeller", fields: [sellerId], references: [id])
  organizationId String?
  status         String       @default("PENDING")
  subtotal       Int
  deliveryCost   Int          @default(0)
  total          Int
  address        String?
  comment        String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  items          OrderItem[]
  events         OrderEvent[]

  @@index([buyerId])
  @@index([sellerId])
}

/// Позиция заказа: снапшот предложения на момент покупки
/// (title/unit/price фиксируются — каталог меняется, заказ нет).
model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  offerId   String
  offer     ProductOffer @relation(fields: [offerId], references: [id])
  title     String
  unit      String
  price     Int
  quantity  Int
  total     Int

  @@index([orderId])
}

/// Событие жизненного цикла заказа (аудит статусов).
model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      String
  actorId   String?
  actor     User?    @relation("OrderActor", fields: [actorId], references: [id])
  payload   String?
  createdAt DateTime @default(now())

  @@index([orderId])
}

/// Служебный счётчик номеров заказов: год → последовательность.
/// Инкремент внутри транзакции создания заказа (атомарность номера).
model OrderCounter {
  year Int @id
  seq  Int @default(0)
}

/// Членство пользователя в организации.
/// role: CUSTOMER | STORE_OWNER | WHOLESALE_SELLER | CARRIER (строка
/// вместо enum — ограничение SQLite, значения проверяются в DTO).
model Membership {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([userId, organizationId, role])
  @@index([userId])
}

/// Торговая точка розничной организации.
model BusinessLocation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  address        String
  city           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}
