// Схема данных Bazar (Промт 7: минимальный фундамент).
//
// С Промта 9 провайдер — PostgreSQL (Neon, ADR 0010): pooled-URI —
// для runtime, direct-URI — для миграций. SQLite остаётся локальным
// fallback без сети (архив миграций — _sqlite-migrations-backup).
// Промт 8 добавил каталог: Category → Product → ProductOffer.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL_POOLED")
  directUrl = env("DATABASE_URL_DIRECT")
}

/// Пользователь. Пароль хранится как хеш Argon2id — никогда не
/// покидает сервер (в ответах API его нет).
model User {
  id               String            @id @default(cuid())
  phone            String            @unique
  name             String
  passwordHash     String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  memberships      Membership[]
  sessions         Session[]
  carts            Cart[]
  orders           Order[]           @relation("OrderBuyer")
  orderEvents      OrderEvent[]      @relation("OrderActor")
  notifications    Notification[]    @relation("UserNotifications")
  deliveryRequests DeliveryRequest[] @relation("DeliveryRequester")
  deliveryEvents   DeliveryEvent[]   @relation("DeliveryActor")
  stockMovements   StockMovement[]   @relation("StockMovementActor")
  priceRequests    PriceRequest[]    @relation("PriceRequestBuyer")
}

/// Сессия refresh-токена. В БД лежит только SHA-256-хеш токена.
/// family связывает цепочку обновлений одного входа: при попытке
/// повторно использовать отозванный токен отзывается вся семья.
model Session {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshHash String    @unique
  family      String
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?
  userAgent   String?
  ip          String?

  @@index([userId])
  @@index([family])
}

/// Организация. type: WHOLESALE | RETAIL | LOGISTICS (строка вместо
/// enum — ограничение SQLite, значения проверяются в DTO).
model Organization {
  id             String             @id @default(cuid())
  name           String
  type           String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  memberships    Membership[]
  locations      BusinessLocation[]
  stockLocations StockLocation[]
  offers         ProductOffer[]
  products       Product[]          @relation("ProductOwner")
  ordersAsSeller Order[]            @relation("OrderSeller")
  deliveries     DeliveryRequest[]  @relation("DeliveryCarrier")
}

/// Категория каталога (Промт 8). slug — адрес фильтра, icon — имя
/// иконки из набора Lucide (клиент маппит в компонент), sortOrder —
/// порядок в ленте категорий.
model Category {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  icon      String
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

/// Товар каталога. images — JSON-массив строк-URL (SQLite не имеет
/// нативных массивов); до загрузки фото клиент показывает плашку-
/// заглушку. Цены живут в ProductOffer: один товар — много продавцов.
/// Промт 10: subtitle, archivedAt (soft-delete продавцом) и
/// организация-владелец (null — системные товары сида Промта 8).
model Product {
  id             String         @id @default(cuid())
  categoryId     String
  name           String
  subtitle       String?
  unit           String
  description    String         @default("")
  images         String         @default("[]")
  organizationId String?
  archivedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  category       Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  organization   Organization?  @relation("ProductOwner", fields: [organizationId], references: [id])
  offers         ProductOffer[]

  @@index([categoryId])
  @@index([organizationId])
}

/// Предложение организации на товар: цена в копейках (без дробей),
/// минимальная партия, бейдж («hit» — хит) и скоропорт.
/// badge — строка или null; набор значений расширяется без миграций.
/// Промт 10: archivedAt — архив предложения (нулевой доступный
/// остаток скрывает из каталога, архив — из кабинета продавца).
/// Промт 11: остатки — event-sourced (StockMovement + StockBalance,
/// ADR 0012); колонка stock удалена, доступно = SUM(availableQty)
/// по складам организации.
/// Промт 16 (C): priceOnRequest — «цена по запросу»: базовая цена
/// обязательна (>0), но не покидает сервер в публичных ответах
/// каталога (priceKopecks: null, priceOnRequest: true — ADR 0016).
model ProductOffer {
  id             String              @id @default(cuid())
  productId      String
  organizationId String
  priceKopecks   Int
  priceOnRequest Boolean             @default(false)
  minQuantity    Int                 @default(1)
  badge          String?
  isPerishable   Boolean             @default(false)
  archivedAt     DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  product        Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cartItems      CartItem[]
  orderItems     OrderItem[]
  priceHistory   OfferPriceHistory[]
  stockBalances  StockBalance[]
  stockMovements StockMovement[]
  priceRequests  PriceRequest[]

  @@index([productId])
  @@index([organizationId])
}

/// История цены предложения (Промт 10): каждая смена price — новая
/// запись. Аудит для продавца («collapsed История цены» в карточке).
model OfferPriceHistory {
  id           String       @id @default(cuid())
  offerId      String
  offer        ProductOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  priceKopecks Int
  actorId      String?
  createdAt    DateTime     @default(now())

  @@index([offerId])
}

/// Склад организации (Промт 11): физическое место хранения —
/// «Основной склад», «Точка на Садовой». isDefault — куда попадают
/// INITIAL/ADJUSTMENT-движения без явного склада; создаётся
/// автоматически при onboarding и лениво при первом движении.
model StockLocation {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  type           StockLocationType
  address        String?
  isDefault      Boolean           @default(false)
  createdAt      DateTime          @default(now())
  balances       StockBalance[]
  movements      StockMovement[]

  @@index([organizationId])
}

enum StockLocationType {
  WAREHOUSE
  STORE
  OTHER
}

/// Событие движения товара (Промт 11, append-only журнал).
///
/// quantityDelta — знак эффекта на доступный остаток: RESERVED
/// уменьшает доступность (резерв), UNRESERVED возвращает, SALE_OUT
/// списывает физический остаток, TRANSFER_OUT/TRANSFER_IN — пара
/// перемещения. Пересчёт баланса — по типу движения (ADR 0012).
/// refType/refId — ссылка на источник: order/<orderId>, manual,
/// initial, legacy. actor — кто выполнил движение.
model StockMovement {
  id            String            @id @default(cuid())
  offerId       String
  offer         ProductOffer      @relation(fields: [offerId], references: [id])
  locationId    String
  location      StockLocation     @relation(fields: [locationId], references: [id])
  type          StockMovementType
  quantityDelta Int
  reason        String
  actorId       String?
  actor         User?             @relation("StockMovementActor", fields: [actorId], references: [id])
  refType       String?
  refId         String?
  createdAt     DateTime          @default(now())

  @@index([offerId, locationId, createdAt])
  @@index([refType, refId])
}

enum StockMovementType {
  INITIAL
  RECEIPT
  SALE_OUT
  RETURN_IN
  WRITE_OFF
  ADJUSTMENT
  TRANSFER_OUT
  TRANSFER_IN
  RESERVED
  UNRESERVED
}

/// Денормализованный остаток оффера на складе (Промт 11):
/// physicalQty — физический остаток, reservedQty — резерв активных
/// заказов, availableQty = physicalQty − reservedQty (кэш для
/// каталога/корзины; пересчитывается при каждом движении).
/// Источник правды — журнал StockMovement, баланс — агрегат.
model StockBalance {
  id           String        @id @default(cuid())
  offerId      String
  offer        ProductOffer  @relation(fields: [offerId], references: [id], onDelete: Cascade)
  locationId   String
  location     StockLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  physicalQty  Int           @default(0)
  reservedQty  Int           @default(0)
  availableQty Int           @default(0)
  updatedAt    DateTime      @updatedAt

  @@unique([offerId, locationId])
  @@index([offerId])
}

/// Корзина пользователя в контуре (Промт 9, Часть D).
/// organizationId — торговый контур: «"» (розница/customer) или id
/// организации оптового контура. Пустая строка вместо NULL — иначе
/// @@unique([userId, organizationId]) в PostgreSQL не ловит дубли
/// (NULL ≠ NULL).
model Cart {
  id             String     @id @default(cuid())
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String     @default("")
  items          CartItem[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([userId, organizationId])
}

/// Позиция корзины: предложение продавца + количество.
/// @@unique([cartId, offerId]) — один оффер одна строка (количество
/// меняется PATCH'ем, а не новой строкой).
/// Промт 16 (C): priceRequestId — персональное предложение, по
/// которому позиция добавлена: цена строки = quotedPriceKopecks
/// (не базовая цена оффера). Строка без запроса — обычная цена.
model CartItem {
  id             String        @id @default(cuid())
  cartId         String
  cart           Cart          @relation(fields: [cartId], references: [id], onDelete: Cascade)
  offerId        String
  offer          ProductOffer  @relation(fields: [offerId], references: [id], onDelete: Cascade)
  quantity       Int
  priceRequestId String?
  priceRequest   PriceRequest? @relation(fields: [priceRequestId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([cartId, offerId])
}

/// Заказ (Промт 9, Часть E): создаётся из корзины, группируется
/// по продавцу — позиции разных организаций раскладываются в
/// отдельные заказы. Номер BZ-YYYY-NNNNNN генерируется в транзакции.
model Order {
  id             String            @id @default(cuid())
  number         String            @unique
  buyerId        String
  buyer          User              @relation("OrderBuyer", fields: [buyerId], references: [id])
  sellerId       String
  seller         Organization      @relation("OrderSeller", fields: [sellerId], references: [id])
  organizationId String?
  status         String            @default("PENDING")
  subtotal       Int
  deliveryCost   Int               @default(0)
  total          Int
  address        String?
  comment        String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  items          OrderItem[]
  events         OrderEvent[]
  deliveries     DeliveryRequest[] @relation("OrderDeliveries")

  @@index([buyerId])
  @@index([sellerId])
}

/// Позиция заказа: снапшот предложения на момент покупки
/// (title/unit/price фиксируются — каталог меняется, заказ нет).
/// Промт 16 (C): priceRequestId — трассировка персонального
/// предложения, по цене которого куплено (без FK: заказ живёт
/// дольше запроса; колонка — снимок для аудита).
model OrderItem {
  id             String       @id @default(cuid())
  orderId        String
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  offerId        String
  offer          ProductOffer @relation(fields: [offerId], references: [id])
  title          String
  unit           String
  price          Int
  quantity       Int
  total          Int
  priceRequestId String?

  @@index([orderId])
}

/// Событие жизненного цикла заказа (аудит статусов).
model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      String
  actorId   String?
  actor     User?    @relation("OrderActor", fields: [actorId], references: [id])
  payload   String?
  createdAt DateTime @default(now())

  @@index([orderId])
}

/// Уведомление пользователя (Промт 10, Часть C): создаётся при
/// смене статуса заказа продавцом (адресат — покупатель) и при
/// создании/отмене заказа покупателем (адресаты — продавцы
/// организации). payload — JSON-снапшот контекста события.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  /// NEW_ORDER | ORDER_STATUS | ORDER_CANCELLED
  type      String
  title     String
  body      String
  payload   String?
  orderId   String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

/// Служебный счётчик номеров заказов: год → последовательность.
/// Инкремент внутри транзакции создания заказа (атомарность номера).
model OrderCounter {
  year Int @id
  seq  Int @default(0)
}

/// Заявка на доставку заказа (Промт 10, Часть D).
///
/// Создаётся покупателем или продавцом по подтверждённому заказу
/// (статусная машина: PENDING → ACCEPTED → PICKED_UP → IN_TRANSIT →
/// DELIVERED → COMPLETED; отмена — из PENDING инициатором заявки
/// или из ACCEPTED перевозчиком). Номер DL-YYYY-NNNNNN (счётчик
/// DeliveryCounter). Одна активная заявка на заказ. price — ставка
/// перевозчика в копейках, фиксируется при принятии.
/// carrierOrganizationId — организация перевозчика, принявшая
/// заявку (командная модель: любой её член ведёт рейс).
model DeliveryRequest {
  id                    String          @id @default(cuid())
  number                String          @unique
  orderId               String
  order                 Order           @relation("OrderDeliveries", fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  /// Кто создал заявку: покупатель или член организации-продавца.
  requesterId           String
  requester             User            @relation("DeliveryRequester", fields: [requesterId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  /// Организация-перевозчик, принявшая заявку.
  carrierOrganizationId String?
  carrierOrganization   Organization?   @relation("DeliveryCarrier", fields: [carrierOrganizationId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  status                String          @default("PENDING")
  pickupAddress         String
  pickupContact         String
  dropoffAddress        String
  dropoffContact        String
  weightKg              Float?
  volumeL               Float?
  cargoNotes            String?
  /// Ставка перевозчика в копейках (при принятии).
  price                 Int?
  cancelReason          String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  events                DeliveryEvent[]

  @@index([orderId])
  @@index([carrierOrganizationId])
  @@index([status])
}

/// Событие жизненного цикла доставки (аудит переходов).
model DeliveryEvent {
  id         String          @id @default(cuid())
  deliveryId String
  delivery   DeliveryRequest @relation(fields: [deliveryId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  type       String
  actorId    String?
  actor      User?           @relation("DeliveryActor", fields: [actorId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  payload    String?
  createdAt  DateTime        @default(now())

  @@index([deliveryId])
}

/// Служебный счётчик номеров доставок: год → последовательность.
/// Инкремент внутри транзакции создания заявки (атомарность номера).
model DeliveryCounter {
  year Int @id
  seq  Int @default(0)
}

/// Запрос цены «по запросу» (Промт 16, C — ADR 0016).
///
/// buyer → offer + quantity (+ сообщение); продавец отвечает
/// ценой (копейки) или отклоняет. Ответ действует 72 часа
/// (validUntil); продление/редактирование недоступны — новый
/// запрос. Истечение ВЫЧИСЛЯЕМОЕ (ANSWERED && validUntil < now),
/// без cron: просроченный запрос не меняет статус в БД.
/// Идемпотентность: один PENDING-запрос на пару (buyer, offer) —
/// повторное создание возвращает существующий.
model PriceRequest {
  id                 String             @id @default(cuid())
  buyerId            String
  buyer              User               @relation("PriceRequestBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  offerId            String
  offer              ProductOffer       @relation(fields: [offerId], references: [id], onDelete: Cascade)
  quantity           Int
  message            String?
  status             PriceRequestStatus @default(PENDING)
  /// Ответ продавца: цена за единицу в копейках.
  quotedPriceKopecks Int?
  /// Срок действия предложения: respondedAt + 72 часа.
  validUntil         DateTime?
  respondedAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  cartItems          CartItem[]

  @@index([buyerId, createdAt])
  @@index([offerId])
  @@index([status])
}

enum PriceRequestStatus {
  PENDING
  ANSWERED
  DECLINED
}

/// Членство пользователя в организации.
/// role: CUSTOMER | STORE_OWNER | WHOLESALE_SELLER | CARRIER (строка
/// вместо enum — ограничение SQLite, значения проверяются в DTO).
model Membership {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([userId, organizationId, role])
  @@index([userId])
}

/// Торговая точка розничной организации.
model BusinessLocation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  address        String
  city           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}
