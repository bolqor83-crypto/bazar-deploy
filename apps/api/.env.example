# Пример окружения API Bazar. Скопировать в .env и заполнить секреты.
# Промт 9: БД — PostgreSQL (Neon); pooled — для serverless-подключений,
# direct — для миграций и long-running NestJS (интерактивные транзакции).
PORT=3000
NODE_ENV=development
DATABASE_URL_POOLED=<postgresql://user:pass@host-pooler/db?sslmode=require>
DATABASE_URL_DIRECT=<postgresql://user:pass@host/db?sslmode=require>
JWT_ACCESS_SECRET=<случайная строка минимум 32 символа>
JWT_ACCESS_TTL_SEC=900
REFRESH_TTL_SEC=2592000
CORS_ORIGINS=
THROTTLER_DISABLED=false
MOBILE_DIST_PATH=
