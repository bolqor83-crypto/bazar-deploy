# Символические ссылки pnpm (isolated linker) плохо дружат с Metro и Expo CLI.
# Хоистинг делает структуру node_modules предсказуемой для Expo Go, Metro, Jest и CI.
node-linker=hoisted

# Не блокировать установку из-за нестрогих peer-зависимостей React Native-экосистемы.
strict-peer-dependencies=false
