{
  "name": "bazar",
  "version": "0.1.0",
  "private": true,
  "description": "Bazar — цифровая торговая экосистема оптового и розничного аграрного рынка (монорепо)",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "mobile": "pnpm --filter mobile start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "ci": "turbo lint typecheck test",
    "prepare": "husky",
    "lint:visual": "node scripts/check-visual-rules.mjs"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "husky": "^9.1.7",
    "libsodium-wrappers": "0.7.15",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3"
  }
}
